    {
      "id": "multi.terminal.vim_hello_world_script",
      "category": "multi_turn",
      "instruction": "In Terminal, create ~/hello_world.py using Vim so that running it prints \"Hello, World!\" exactly ten times, then run it. Open vim and and write the script, then save and run it.",
      "setup": {
        "kind": "native_app",
