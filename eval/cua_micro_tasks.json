{
  "schema_version": 1,
  "suite": "cua_micro_tasks",
  "coordinate_grid": 1000,
  "description": "Balanced atomic and short-horizon CUA micro-evals with per-turn semantic state verifiers.",
  "tasks": [
    {
      "id": "click.desktop.libreoffice_writer",
      "category": "native_launch",
      "instruction": "Click the LibreOffice Writer icon under the cursor.",
      "setup": {
        "kind": "desktop"
      },
      "target": {
        "kind": "fixed_norm",
        "bbox": [
          2,
          285,
          38,
          345
        ],
        "label": "LibreOffice Writer dock icon"
      },
      "cursor": {
        "kind": "target_center"
      },
      "expected": {
        "kind": "click",
        "button": "left"
      },
      "verifier": {
        "kind": "active_title_regex",
        "pattern": "LibreOffice Writer"
      }
    },
    {
      "id": "click.desktop.libreoffice_impress",
      "category": "native_launch",
      "instruction": "Click the LibreOffice Impress icon under the cursor.",
      "setup": {
        "kind": "desktop"
      },
      "target": {
        "kind": "fixed_norm",
        "bbox": [
          2,
          415,
          38,
          475
        ],
        "label": "LibreOffice Impress dock icon"
      },
      "cursor": {
        "kind": "target_center"
      },
      "expected": {
        "kind": "click",
        "button": "left"
      },
      "verifier": {
        "kind": "active_title_regex",
        "pattern": "LibreOffice Impress"
      }
    },
    {
      "id": "key.desktop.open_terminal",
      "category": "multi_turn",
      "instruction": "Open Terminal with the Ctrl+Alt+T keyboard shortcut.",
      "setup": {
        "kind": "desktop"
      },
      "turn_mode": "multiturn",
      "turn": {
        "target": {
          "kind": "fixed_norm",
          "bbox": [
            50,
            100,
            950,
            900
          ],
          "label": "Desktop"
        },
        "cursor": {
          "kind": "target_center"
        },
        "expected": {
          "kind": "any"
        },
        "verifier": {
          "kind": "guest_command_regex",
          "command": "command -v pgrep >/dev/null && { pgrep -a -f '^/usr/libexec/gnome-terminal-server' || true; }",
          "pattern": "gnome-terminal-server"
        }
      },
      "max_turns": 4
    },
    {
      "id": "type.terminal.native_exact",
      "category": "native_app",
      "instruction": "Type exactly into the focused Terminal: echo This is a typing test. I am trained by omegalax",
      "setup": {
        "kind": "native_terminal_capture"
      },
      "target": {
        "kind": "fixed_norm",
        "bbox": [
          100,
          150,
          900,
          850
        ],
        "label": "Terminal input"
      },
      "cursor": {
        "kind": "target_center"
      },
      "expected": {
        "kind": "type",
        "text": "echo This is a typing test. I am trained by omegalax"
      },
      "verifier": {
        "kind": "guest_json_equals",
        "path": "/tmp/cua_native_terminal_state.json",
        "field": "value",
        "value": "echo This is a typing test. I am trained by omegalax"
      }
    },
    {
      "id": "type.text_editor.native_exact",
      "category": "native_app",
      "instruction": "Type exactly into the focused Text Editor document: Hello, World! This is a typing test. I am trained by omegalax",
      "setup": {
        "kind": "native_app",
        "app": "text_editor"
      },
      "target": {
        "kind": "fixed_norm",
        "bbox": [
          150,
          150,
          850,
          850
        ],
        "label": "Text Editor document"
      },
      "cursor": {
        "kind": "target_center"
      },
      "expected": {
        "kind": "type",
        "text": "Hello, World! This is a typing test. I am trained by omegalax"
      },
      "verifier": {
        "kind": "saved_file_equals",
        "path": "/tmp/cua_native_editor.txt",
        "value": "Hello, World! This is a typing test. I am trained by omegalax"
      }
    },
    {
      "id": "key.writer.open_save_as",
